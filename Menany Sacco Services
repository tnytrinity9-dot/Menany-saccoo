------MultipartBoundary--UmlyVGVzJ8mwx4zKVn2pnRDdIjtQ6GHLpSILwUSlc9----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: http://localhost:7700/style.css

@charset "utf-8";

:root { --blue: #063b9b; --blue2: #075ee8; --red: #e31b2f; --yellow: #ffd400; --ink: #111827; --muted: #667085; --light: #f5f8ff; --shadow: 0 16px 45px #062e7b1c; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; font-family: Inter, Arial, sans-serif; color: var(--ink); line-height: 1.55; }

a { text-decoration: none; color: inherit; }

.container { width: min(1160px, 92%); margin: auto; }

.topbar { background: var(--blue); color: white; font-size: 12px; }

.topin { display: flex; justify-content: space-between; padding: 7px 0px; }

.header { position: sticky; top: 0px; z-index: 20; background: rgba(255, 255, 255, 0.933); backdrop-filter: blur(12px); box-shadow: rgba(0, 0, 0, 0.043) 0px 2px 20px; }

.nav { min-height: 76px; display: flex; align-items: center; gap: 22px; }

.brand { display: flex; gap: 9px; align-items: center; margin-right: auto; }

.mark { width: 43px; height: 43px; display: grid; place-items: center; border-radius: 12px; background: var(--blue); color: white; font: 900 25px Montserrat; }

.brand b { display: block; font: 900 21px Montserrat; color: var(--blue); }

.brand small { display: block; color: var(--red); font-size: 9px; font-weight: 900; letter-spacing: 0.7px; }

nav { display: flex; gap: 18px; font-size: 13px; font-weight: 800; }

nav a:hover { color: var(--red); }

.call { background: var(--red); color: white; padding: 10px 15px; border-radius: 999px; font-size: 12px; font-weight: 900; }

.menu { display: none; border: 0px; background: none; font-size: 26px; }

.hero { position: relative; min-height: 650px; display: flex; align-items: center; overflow: hidden; background: var(--blue); color: white; }

.hero-bg { position: absolute; inset: 0px; background: linear-gradient(90deg, rgba(2, 22, 62, 0.933), rgba(2, 22, 62, 0.6) 48%, rgba(2, 22, 62, 0.133)), url("assets/menany-vehicle-side.jpg") center center / cover; }

.hero-content { position: relative; padding: 90px 0px; }

.eyebrow { font-size: 11px; font-weight: 900; letter-spacing: 2px; color: var(--yellow); }

h1, h2, h3 { font-family: Montserrat, Inter, sans-serif; line-height: 1.1; }

h1 { font-size: clamp(44px, 7vw, 76px); max-width: 800px; margin: 12px 0px; }

h1 em { font-style: normal; color: var(--yellow); }

.hero p { max-width: 650px; font-size: 18px; color: rgb(232, 239, 255); }

.actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 26px 0px; }

.btn { display: inline-flex; align-items: center; justify-content: center; padding: 13px 22px; border-radius: 999px; border: 0px; font-weight: 900; cursor: pointer; transition: 0.25s; }

.btn:hover { transform: translateY(-3px); box-shadow: rgba(0, 0, 0, 0.2) 0px 12px 28px; }

.red { background: var(--red); color: white; }

.white { background: white; color: var(--blue); }

.pulse { animation: 2s ease 0s infinite normal none running pulse; }

.trust { font-size: 12px; font-weight: 700; }

.seal { position: absolute; right: 6%; top: 12%; width: 115px; height: 115px; border: 5px solid var(--yellow); border-radius: 50%; background: var(--red); display: grid; place-items: center; text-align: center; font-size: 10px; font-weight: 900; line-height: 1.05; transform: rotate(7deg); box-shadow: rgba(0, 17, 63, 0.6) 0px 15px 30px; }

.seal b { color: var(--yellow); }

.quick { margin-top: -42px; position: relative; z-index: 3; }

.quickgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }

.quickgrid a { background: white; border-radius: 18px; padding: 20px; box-shadow: var(--shadow); transition: 0.25s; }

.quickgrid a:hover { transform: translateY(-6px); }

.quickgrid b, .quickgrid small { display: block; }

.quickgrid small { font-size: 11px; color: var(--muted); margin-top: 4px; }

.section { padding: 90px 0px; }

.head { text-align: center; max-width: 720px; margin: 0px auto 35px; }

.head h2, .booking h2, .parcel h2, .contact h2 { font-size: clamp(31px, 4vw, 48px); margin: 8px 0px 12px; }

.head p, .booking p, .contact p { color: var(--muted); }

.blue { color: var(--blue); }

.tools { display: flex; gap: 12px; margin-bottom: 18px; }

.tools input, .tools select, .booking input, .booking select, .booking textarea { width: 100%; padding: 14px; border: 1px solid rgb(216, 223, 237); border-radius: 12px; background: white; font: inherit; outline: 0px; }

.tools input { flex: 2 1 0%; }

.tools select { flex: 1 1 0%; }

.tools input:focus, .tools select:focus, .booking input:focus, .booking select:focus, .booking textarea:focus { border-color: var(--blue2); box-shadow: rgba(7, 94, 232, 0.1) 0px 0px 0px 4px; }

.routes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }

.route { border: 1px solid rgb(226, 232, 240); border-radius: 17px; padding: 19px; box-shadow: rgba(6, 46, 123, 0.05) 0px 8px 24px; transition: 0.25s; }

.route:hover { transform: translateY(-4px); }

.route h3 { font-size: 16px; margin: 0px 0px 4px; }

.route small { font-size: 10px; font-weight: 900; color: var(--blue); text-transform: uppercase; }

.fare { font-size: 20px; font-weight: 900; color: var(--red); float: right; }

.route button { width: 100%; margin-top: 12px; border: 0px; background: var(--yellow); border-radius: 10px; padding: 9px; font-weight: 900; cursor: pointer; }

.note, .empty { text-align: center; color: var(--muted); font-size: 12px; }

.dark { background: linear-gradient(135deg, rgb(3, 26, 77), rgb(6, 59, 155)); color: white; }

.light p { color: rgb(203, 216, 244); }

.servicegrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; }

.servicegrid article { padding: 25px; border: 1px solid rgba(255, 255, 255, 0.125); background: rgba(255, 255, 255, 0.047); border-radius: 20px; transition: 0.25s; }

.servicegrid article:hover { transform: translateY(-6px); }

.servicegrid i { font-style: normal; font-size: 32px; }

.servicegrid h3 { font-size: 19px; }

.servicegrid p { color: rgb(216, 226, 245); font-size: 13px; }

.stats { background: var(--yellow); padding: 32px 0px; }

.statsgrid { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; }

.stats b { display: block; font: 900 35px Montserrat; color: var(--blue); }

.stats span { font-size: 11px; font-weight: 800; }

.booking { display: grid; grid-template-columns: 1fr 1fr; gap: 55px; align-items: start; }

.benefits { font-weight: 700; line-height: 2; margin-top: 22px; }

.booking form { display: grid; gap: 13px; padding: 28px; border: 1px solid rgb(226, 232, 240); border-radius: 22px; box-shadow: var(--shadow); }

.booking label { font-size: 11px; font-weight: 900; }

.booking label input, .booking label select, .booking label textarea { display: block; margin-top: 5px; }

.two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

.hint { color: var(--muted); font-size: 10px; text-align: center; }

.parcel { padding: 62px 0px; background: linear-gradient(100deg,var(--red),#ad0919); color: white; }

.parcelin { display: flex; align-items: center; justify-content: space-between; gap: 30px; }

.parcel p { max-width: 650px; }

.gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }

.gallery button { height: 300px; border: 0px; padding: 0px; border-radius: 18px; overflow: hidden; position: relative; cursor: pointer; background: rgb(221, 221, 221); }

.gallery img { width: 100%; height: 100%; object-fit: cover; transition: 0.5s; }

.gallery button:hover img { transform: scale(1.08); }

.gallery span { position: absolute; bottom: 12px; left: 12px; right: 12px; padding: 9px; background: rgba(0, 0, 0, 0.733); color: white; border-radius: 9px; text-align: left; font-weight: 800; }

.contact { padding: 70px 0px; background: var(--blue); color: white; }

.contactin { display: flex; justify-content: space-between; align-items: center; gap: 30px; }

.contact p { color: rgb(219, 229, 255); max-width: 580px; }

.contactlinks { display: grid; gap: 10px; min-width: 300px; }

.contactlinks a { background: rgba(255, 255, 255, 0.063); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 14px; padding: 14px 18px; display: flex; gap: 12px; align-items: center; }

.contactlinks small, .contactlinks b { display: block; }

.contactlinks small { font-size: 9px; color: rgb(203, 216, 244); }

.contactlinks b { font-size: 18px; }

.footerin { display: flex; justify-content: space-between; align-items: center; padding: 28px 0px; font-size: 11px; }

.footerin p { margin: 3px 0px; color: var(--muted); }

.floatwa { position: fixed; right: 18px; bottom: 18px; width: 54px; height: 54px; border-radius: 50%; background: rgb(24, 168, 90); color: white; display: grid; place-items: center; font-size: 24px; box-shadow: rgba(0, 0, 0, 0.267) 0px 10px 25px; z-index: 30; }

.lightbox { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.9); z-index: 1000; display: none; place-items: center; padding: 25px; }

.lightbox.show { display: grid !important; }

.lightbox img { max-width: 95%; max-height: 90%; object-fit: contain; border-radius: 12px; }

.lightbox button { position: absolute; right: 20px; top: 15px; border: 0px; background: none; color: white; font-size: 42px; cursor: pointer; }

@media (max-width: 850px) {
  nav { display: none; position: absolute; left: 4%; right: 4%; top: 70px; background: white; padding: 15px; border-radius: 15px; box-shadow: var(--shadow); flex-direction: column; }
  .menu { display: block; }
  .call { display: none; }
  .quickgrid, .servicegrid, .routes { grid-template-columns: 1fr 1fr; }
  .booking { grid-template-columns: 1fr; }
  .gallery { grid-template-columns: 1fr 1fr; }
  .hero { min-height: 590px; }
  .seal { width: 90px; height: 90px; font-size: 8px; right: 3%; top: 8%; }
}

@media (max-width: 560px) {
  .topin { font-size: 9px; }
  .quickgrid, .servicegrid, .routes, .gallery, .statsgrid { grid-template-columns: 1fr; }
  .section { padding: 65px 0px; }
  .hero-content { padding: 75px 0px; }
  .hero p { font-size: 15px; }
  .trust { line-height: 2; }
  .tools, .two, .contactin, .parcelin { display: grid; grid-template-columns: 1fr; }
  .gallery button { height: 270px; }
  .footerin { display: grid; gap: 8px; }
  .seal { display: none; }
}

.reveal { animation: 0.7s ease 0s 1 normal both running rise; }

@keyframes rise { 
  0% { opacity: 0; transform: translateY(18px); }
  100% { opacity: 1; transform: none; }
}
